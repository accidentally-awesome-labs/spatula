{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spatula-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // spatula.run, Spatula's own domain (ADR 0006): its public page, key directory, and API. It's
  // the only address that names Spatula, so workers.dev is off.
  "routes": [{ "pattern": "spatula.run", "custom_domain": true }],
  "workers_dev": false,
  "vars": {
    "SPATULA_VERSION": "0.2.0-dev",
    // Where the user agent sends a site that wants to know who's asking: the Worker's public page.
    // The Signature-Agent names its origin too.
    "PUBLIC_URL": "https://spatula.run",
    // The model of a job a definition doesn't name (ADR 0010).
    "LLM_MODEL": "anthropic/claude-opus-5-5",
    // The providers whose keys the gateway holds, comma-separated; they need AI_GATEWAY_TOKEN.
    "LLM_GATEWAY_KEYS": "",
    // Each model's list price, dollars per million tokens in and out, as its provider's pricing
    // page gave it on the date beside it. A model without one can't be named (ADR 0010).
    "LLM_PRICES": {
      "anthropic/claude-opus-5-5": [4, 20], // anthropic.com/pricing, 2026-10-24
      "anthropic/claude-haiku-5-5": [0.1, 0.5], // anthropic.com/pricing, 2026-10-24
    },
    // "true" once Cloudflare lists Spatula as a verified bot, which the owner sets (ADR 0006).
    "VERIFIED_BOT": "false",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // spatula-db, which the owner created; it connects to Neon as spatula_app.
      "id": "8769cf79fdfe44d386441af12fce6aca",
      "localConnectionString": "postgres://spatula:spatula@localhost:5434/spatula",
    },
  ],
  "r2_buckets": [{ "binding": "STORE", "bucket_name": "spatula-store" }],
  "durable_objects": { "bindings": [{ "name": "HOST_GATE", "class_name": "HostGate" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HostGate"] }],
  "workflows": [
    { "name": "spatula-refresh", "binding": "REFRESH", "class_name": "RefreshWorkflow" },
  ],
  // The review API's writes (ADR 0009): 120 a minute for the owner, and for each of a consumer's
  // reviewers; and 240 a minute for each consumer's reviewers together, since a consumer names its
  // reviewers itself. A bulk request counts once.
  "ratelimits": [
    { "name": "REVIEW_LIMITER", "namespace_id": "2001", "simple": { "limit": 120, "period": 60 } },
    {
      "name": "CONSUMER_REVIEW_LIMITER",
      "namespace_id": "2002",
      "simple": { "limit": 240, "period": 60 },
    },
  ],
}
